#:import t theme
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import NoTransition kivy.uix.screenmanager.NoTransition

<QuietButton>:
    font_name: t.FONT_BODY
    font_size: '15sp'
    color: t.BG if self.primary else (t.DANGER if self.danger else t.ACCENT)
    disabled_color: t.MUTED
    size_hint_y: None
    height: dp(48)
    text_size: self.width - dp(12), self.height
    halign: 'center'
    valign: 'middle'
    shorten: True
    canvas.before:
        Color:
            rgba: t.ACCENT if self.primary else (t.LINE if self.state == 'down' else t.PANEL)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]

<NoteInput>:
    background_normal: ''
    background_active: ''
    background_color: t.BG
    foreground_color: t.TEXT
    hint_text_color: t.MUTED
    cursor_color: t.ACCENT
    selection_color: (0.3, 0.6, 0.4, 0.35)
    font_name: t.FONT_BODY
    font_size: '18sp'
    padding: [dp(20), dp(16)]
    write_tab: False

<QuietLabel@Label>:
    font_name: t.FONT_MONO
    font_size: '11sp'
    color: t.MUTED
    halign: 'left'
    valign: 'middle'
    text_size: self.size

<TopBar@BoxLayout>:
    size_hint_y: None
    height: dp(72)
    padding: [dp(16), dp(12)]
    spacing: dp(8)

<Wordmark@Label>:
    text: 'PURENOTE'
    font_name: t.FONT_RETRO
    font_size: '24sp'
    color: t.ACCENT
    halign: 'left'
    valign: 'middle'
    text_size: self.size

<NoteRow>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(116)
    padding: [dp(22), dp(12)]
    spacing: dp(4)
    canvas.before:
        Color:
            rgba: t.PANEL if self.state == 'down' else t.BG
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: t.LINE
        Rectangle:
            pos: self.x + dp(22), self.y
            size: self.width - dp(44), dp(1)
    Label:
        text: root.title
        font_name: t.FONT_BODY
        font_size: '18sp'
        color: t.TEXT
        halign: 'left'
        valign: 'middle'
        text_size: self.width, self.height
        shorten: True
        shorten_from: 'right'
    Label:
        text: root.snippet
        font_name: t.FONT_BODY
        font_size: '14sp'
        color: t.MUTED
        halign: 'left'
        valign: 'middle'
        text_size: self.width, self.height
        shorten: True
        shorten_from: 'right'
    QuietLabel:
        text: root.date
        size_hint_y: None
        height: dp(20)

<ListScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: app.insets
        TopBar:
            Wordmark:
            QuietButton:
                text: '+'
                primary: True
                font_size: '26sp'
                size_hint_x: None
                width: dp(48)
                on_release: app.new_note()
            QuietButton:
                text: 'Menu'
                size_hint_x: None
                width: dp(64)
                on_release: app.open_menu()
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: [dp(16), dp(4)]
            NoteInput:
                id: search
                hint_text: 'Cerca nelle note'
                multiline: False
                font_size: '16sp'
                padding: [dp(14), dp(14)]
                background_color: t.PANEL
                on_text: app.set_query(self.text)
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            padding: [dp(22), 0]
            QuietLabel:
                text: root.summary
            QuietButton:
                id: undo
                text: 'Annulla eliminazione'
                font_size: '13sp'
                disabled: True
                opacity: 0 if self.disabled else 1
                size_hint_x: None
                width: dp(160)
                height: dp(44)
                on_release: app.undo_trash()
        FloatLayout:
            RecycleView:
                id: notes
                viewclass: 'NoteRow'
                bar_width: dp(3)
                RecycleBoxLayout:
                    default_size: None, dp(116)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
            Label:
                id: empty
                text: root.empty_message
                font_name: t.FONT_BODY
                font_size: '17sp'
                color: t.MUTED
                halign: 'center'
                valign: 'middle'
                text_size: self.width - dp(48), self.height

<EditorScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: app.insets
        TopBar:
            QuietButton:
                text: 'Note'
                size_hint_x: None
                width: dp(60)
                on_release: app.go_list()
            Wordmark:
                font_size: min(sp(21), self.width / 5.4)
                halign: 'center'
            QuietButton:
                text: '+'
                font_size: '26sp'
                size_hint_x: None
                width: dp(48)
                on_release: app.new_note()
            QuietButton:
                text: 'Menu'
                size_hint_x: None
                width: dp(60)
                on_release: app.open_menu()
        Widget:
            size_hint_y: None
            height: dp(1)
            canvas:
                Color:
                    rgba: t.LINE
                Rectangle:
                    pos: self.x + dp(20), self.y
                    size: self.width - dp(40), dp(1)
        NoteInput:
            id: body
            hint_text: 'Comincia da un pensiero…'
            line_spacing: dp(6)
            on_text: root.on_text_changed(self.text)
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(88) if root.save_error else dp(72)
            padding: [dp(20), dp(4), dp(20), dp(12)]
            Label:
                text: root.counts
                font_name: t.FONT_BODY
                font_size: '12sp'
                color: t.MUTED
                halign: 'left'
                valign: 'middle'
                text_size: self.size
            QuietButton:
                text: root.status
                font_size: '12sp'
                danger: root.save_error
                height: dp(48) if root.save_error else dp(32)
                halign: 'left'
                on_release: app.flush() if root.save_error else None

RootManager:
    transition: NoTransition()
    canvas.before:
        Color:
            rgba: t.BG
        Rectangle:
            pos: self.pos
            size: self.size
    EditorScreen:
        name: 'editor'
    ListScreen:
        name: 'list'
